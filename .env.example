# Configuración recomendada para la demo: Gemini transcribe y Groq interpreta.
STT_PROVIDER=gemini
LLM_PROVIDER=groq

# Requerida porque STT_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# Solo se usa si LLM_PROVIDER=gemini; debe admitir generateContent y function calling.
# GEMINI_CHAT_MODEL=gemini-3.7-flash

# Requerida porque LLM_PROVIDER=groq.
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Alternativa probada: qwen/qwen3.8-27b (menos consistente en algunas tools).

# Solo se usa si LLM_PROVIDER=openai (la API requiere saldo).
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_CHAT_MODEL=gpt-4.1-mini
