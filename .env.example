# Seleccionar proveedores implementados.
# STT: gemini. LLM: gemini u openai.
STT_PROVIDER=gemini
LLM_PROVIDER=gemini

# Se exige si STT_PROVIDER o LLM_PROVIDER es gemini.
GEMINI_API_KEY=your_gemini_api_key_here
# Solo se usa si STT_PROVIDER=gemini. Debe admitir Live Transcription,
# bidiGenerateContent, input_audio_transcription y texto final de entrada.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# Solo se usa si LLM_PROVIDER=gemini. Debe admitir generateContent y function calling.
GEMINI_CHAT_MODEL=gemini-3.7-flash

# Se exige solo si LLM_PROVIDER=openai.
OPENAI_API_KEY=your_openai_api_key_here
# Modelo de chat con function calling. Disponibles en la cuenta consultada:
# gpt-4.1-mini (recomendado para esta primera prueba), gpt-4.1, gpt-4o,
# gpt-4o-mini, gpt-5-mini, gpt-5 y gpt-5.4-mini. Confirmar siempre con
# GET /v1/models: estar listado no sustituye una prueba real de tools.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Preparado para STT OpenAI futuro; todavia no existe su adaptador streaming.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Referencias para adaptadores futuros no implementados:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# STT_MODEL_PATH=C:\modelos\whisper-o-vosk
