# Configuración recomendada para la demo: Gemini transcribe y Groq interpreta.
STT_PROVIDER=gemini
LLM_PROVIDER=groq

# Requerida porque STT_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key_here
# El modelo STT debe admitir Live Transcription, bidiGenerateContent,
# input_audio_transcription y emitir el texto final reconocido.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live

# Requerida porque LLM_PROVIDER=groq.
GROQ_API_KEY=your_groq_api_key_here
# Modelo probado con el flujo de tools del pedido.
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Para usar Gemini también como chat: LLM_PROVIDER=gemini y configurar
# GEMINI_CHAT_MODEL con un modelo que admita generateContent y function calling.
# GEMINI_CHAT_MODEL=gemini-3.7-flash

# OpenAI también tiene adaptador LLM, pero su API requiere saldo/pago.
# Si se usa, configurar LLM_PROVIDER=openai, OPENAI_API_KEY y OPENAI_CHAT_MODEL.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_CHAT_MODEL=gpt-4.1-mini
