GEMINI_API_KEY=your_gemini_api_key_here
# Modelo que convierte audio en texto durante un turno de voz.
# Recomendado: gemini-3.5-transcribe-live
# Los modelos no son fijos: consultar todos los disponibles con:
# python -m backend.ai.list_models
# Elegir uno con bidiGenerateContent para transcripción en vivo.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# Modelo que interpreta el pedido y ejecuta las tools de OrderService.
# Recomendado: gemini-3.5-flash-lite
# Alternativa para comparar: gemini-2.5-flash-lite
# Los modelos no son fijos: el mismo comando lista también los de chat:
# python -m backend.ai.list_models
# Elegir uno con generateContent para conversación y tools.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
