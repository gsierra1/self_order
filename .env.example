# Configuración recomendada para la demo local: Vosk transcribe y Groq interpreta.
# STT_PROVIDER admite gemini, vosk o whisper_browser.
STT_PROVIDER=vosk
LLM_PROVIDER=groq

# Requerida solo si STT_PROVIDER=gemini o LLM_PROVIDER=gemini.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# GEMINI_CHAT_MODEL=gemini-3.7-flash

# Requerida porque STT_PROVIDER=vosk. Seguí README.md para descargar el modelo.
STT_MODEL_PATH=.models/vosk-model-small-es-0.42

# Solo se usan si STT_PROVIDER=whisper_browser. El navegador descarga el modelo
# desde Hugging Face la primera vez, lo guarda en su caché y lo ejecuta en un
# Worker local. `auto` intenta WebGPU y, si no está disponible, usa WebAssembly
# en CPU. También podés forzar `webgpu` o `wasm`.
# WHISPER_BROWSER_MODEL=onnx-community/whisper-tiny
# WHISPER_BROWSER_DEVICE=auto

# Requerida porque LLM_PROVIDER=groq.
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Solo se usa si LLM_PROVIDER=openai (la API requiere saldo).
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_CHAT_MODEL=gpt-4.1-mini
