# Seleccionar proveedores implementados. Actualmente ambos usan Gemini.
STT_PROVIDER=gemini
LLM_PROVIDER=gemini

# GEMINI_API_KEY se exige si STT_PROVIDER o LLM_PROVIDER es gemini.
# La misma clave Gemini puede servir para ambos adaptadores.
GEMINI_API_KEY=your_gemini_api_key_here
# Solo se usa si STT_PROVIDER=gemini. Debe admitir Live Transcription,
# bidiGenerateContent, input_audio_transcription y texto final de entrada.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# Solo se usa si LLM_PROVIDER=gemini. Debe admitir generateContent y function calling.
GEMINI_CHAT_MODEL=gemini-3.7-flash

# Referencias para adaptadores futuros (no se usan ni se exigen todavía):
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# STT_MODEL_PATH=C:\\modelos\\whisper-o-vosk
