GEMINI_API_KEY=your_gemini_api_key_here
# Modelo que convierte audio en texto durante un turno de voz.
# Recomendado: gemini-3.5-transcribe-live
# Requisitos para usar otro modelo con LiveTranscriber:
# 1. Debe listar bidiGenerateContent para esta cuenta.
# 2. Debe estar documentado para Live Transcription, no solo para un agente Live.
# 3. Debe aceptar response_modalities=["TEXT"] e input_audio_transcription.
# 4. Debe emitir server_content.input_transcription final tras activity_end.
# La lista de modelos solo confirma el requisito 1; validar los otros tres con
# documentación oficial y una prueba real. gemini-3.5-live-translate-preview
# falló el requisito 4 en esta implementación.
# Los modelos no son fijos: consultar todos los disponibles con:
# python -m backend.ai.list_models
# Elegir uno con bidiGenerateContent para transcripción en vivo.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# Modelo que interpreta el pedido y ejecuta las tools de OrderService.
# Verificado en una consulta real el 15/09/2026: gemini-3.7-flash.
# gemini-3.6-flash devolvió saturación temporal (503) en dos intentos.
# Alternativas habilitadas el 15/09/2026: gemini-3.7-flash,
# gemini-3.8-flash y gemini-3.5-flash.
# Los modelos no son fijos: el mismo comando lista también los de chat:
# python -m backend.ai.list_models
# Elegir uno con generateContent para conversación y tools.
GEMINI_CHAT_MODEL=gemini-3.7-flash
